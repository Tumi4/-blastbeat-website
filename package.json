{
  "name": "blastbeat-education",
  "private": true,
  "type": "module",
  "description": "Static site with Netlify Functions: Beat AI assistant proxy, admin backend (auth + Blobs state), public licence registry, and form-submission email + leads intake.",
  "scripts": {
    "serve": "python3 -m http.server 8765",
    "test": "playwright test",
    "test:audit": "python3 tests/audit.py",
    "test:functions": "node --test 'tests/functions/*.test.mjs'",
    "test:screenshots": "playwright test tests/screenshots.spec.ts",
    "test:perf": "playwright test tests/perf.spec.ts",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@netlify/blobs": "^10.7.9"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.49.0"
  }
}
